PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Change these before any real deployment.
ADMIN_API_KEY=change_this_admin_key
CUSTOMER_API_KEY=sk_live_change_this_customer_key
PAYMENT_WEBHOOK_SECRET=change_this_webhook_secret

# Use true only for local testing. Live mode must call real gateway APIs.
ENABLE_PAYMENT_MOCK=false

# bKash merchant credentials from official merchant onboarding.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

# Nagad merchant credentials from official merchant onboarding.
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=

# SMS gateway/provider credentials.
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
